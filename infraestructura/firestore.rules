rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funciones auxiliares de autenticación y roles
    function estaAutenticado() {
      return request.auth != null;
    }
    
    function tieneRol(rol) {
      return estaAutenticado() && request.auth.token.rol == rol;
    }
    
    // Un rol se obtiene de dos formas, ambas imposibles de darse a uno mismo:
    // un claim firmado desde el servidor, o una cuenta de Google con correo verificado asignada por la administración.
    function cuentaGoogleVerificada() {
      return estaAutenticado() && request.auth.token.email_verified == true &&
             request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // El rol de una cuenta de Google figura en la colección privada roles_por_correo (el id es el correo).
    // Solo la administración la escribe; cada persona puede leer únicamente su propio documento.
    function rolDeLaCuenta(rol) {
      return cuentaGoogleVerificada() &&
        exists(/databases/$(database)/documents/roles_por_correo/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/roles_por_correo/$(request.auth.token.email)).data.rol == rol;
    }

    function esAutoridad() {
      return tieneRol('autoridad') || rolDeLaCuenta('autoridad');
    }
    
    function esRecolector() {
      return tieneRol('recolector') || esAutoridad() || rolDeLaCuenta('recolector');
    }
    
    function esPropietario(usuarioId) {
      return estaAutenticado() && request.auth.uid == usuarioId;
    }

    // Colección: Ecopuntos y Puntos Verdes de San Francisco
    match /ecopuntos/{puntoId} {
      allow read: if true;
      allow create, delete: if esAutoridad();
      allow update: if esRecolector() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['capacidadActual', 'ultimoVaciado', 'ultimoOperadorId'])
      ) || esAutoridad();
    }

    function textoCorto(v, max) {
      return v is string && v.size() <= max;
    }

    // Colección: Solicitudes de recolección de residuos (especiales y vecinales)
    match /solicitudes_residuos/{solicitudId} {
      function datosValidosCreacion() {
        let d = request.resource.data;
        return d.keys().hasAll(['solicitudId', 'usuarioId', 'estado', 'tipoResiduo', 'direccion', 'fechaCreacion']) &&
               d.keys().hasOnly(['solicitudId', 'usuarioId', 'nombreCiudadano', 'tipoResiduo', 'subcategoria', 'cantidad',
                                 'direccion', 'fechaSugerida', 'observaciones', 'coords', 'estado', 'fechaCreacion']) &&
               d.solicitudId is string && d.solicitudId.matches('SOL-[A-Z0-9-]{2,24}') &&
               d.estado == 'pendiente' &&
               d.tipoResiduo in ['organico', 'plastico', 'vidrio', 'carton', 'reciclable', 'voluminoso', 'peligroso'] &&
               d.direccion is string && d.direccion.size() > 5 && d.direccion.size() <= 200 &&
               (!('nombreCiudadano' in d) || textoCorto(d.nombreCiudadano, 120)) &&
               (!('subcategoria' in d) || textoCorto(d.subcategoria, 120)) &&
               (!('cantidad' in d) || textoCorto(d.cantidad, 120)) &&
               (!('fechaSugerida' in d) || textoCorto(d.fechaSugerida, 40)) &&
               (!('observaciones' in d) || textoCorto(d.observaciones, 500)) &&
               (!('coords' in d) || (d.coords is list && d.coords.size() == 2));
      }

      // La cuadrilla solo cambia los campos de su tarea y no reasigna el retiro
      function datosValidosRecolector() {
        let d = request.resource.data;
        return request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'fechaRecoleccion', 'recolectorId', 'pesoRealKg', 'qrVerificado',
                           'geocerca', 'distanciaM', 'observacionesRecoleccion']) &&
               d.estado in ['en_camino', 'recolectado'] &&
               (!('pesoRealKg' in d) || (d.pesoRealKg is number && d.pesoRealKg >= 0 && d.pesoRealKg <= 5000)) &&
               (!('geocerca' in d) || d.geocerca in ['dentro', 'fuera', 'sin_gps']) &&
               (!('observacionesRecoleccion' in d) || textoCorto(d.observacionesRecoleccion, 500));
      }

      allow read: if esAutoridad() || esRecolector() ||
        (estaAutenticado() && resource.data.usuarioId == request.auth.uid);

      allow create: if estaAutenticado() &&
        request.resource.data.usuarioId == request.auth.uid &&
        datosValidosCreacion();

      // El vecino solo puede cancelar su pedido mientras sigue pendiente
      allow update: if (esPropietario(resource.data.usuarioId) &&
        resource.data.estado == 'pendiente' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        request.resource.data.estado == 'cancelado') ||
        esAutoridad() ||
        (esRecolector() && datosValidosRecolector());

      allow delete: if esAutoridad();
    }

    // Colección: registro de residuos generados por cada vecino (no crea retiros)
    match /registros_residuos/{registroId} {
      allow read: if esAutoridad() || (estaAutenticado() && resource.data.usuarioId == request.auth.uid);
      allow create: if estaAutenticado() &&
        request.resource.data.keys().hasOnly(['usuarioId', 'categoria', 'cantidadKg', 'fecha']) &&
        request.resource.data.usuarioId == request.auth.uid &&
        request.resource.data.categoria in ['reciclable', 'organico', 'resto', 'voluminoso', 'peligroso'] &&
        request.resource.data.cantidadKg is number &&
        request.resource.data.cantidadKg > 0 && request.resource.data.cantidadKg <= 1000 &&
        request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }

    // Colección: Rutas de recolección planificadas
    match /rutas_recoleccion/{rutaId} {
      allow read: if esRecolector() || esAutoridad();
      allow create, delete: if esAutoridad();
      allow update: if esAutoridad() || (esRecolector() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'paradasCompletadas', 'actualizado']));
    }

    // Colección: Incidentes y reclamos urbanos
    match /incidentes/{incidenteId} {
      function incidenteValido() {
        let d = request.resource.data;
        return d.keys().hasAll(['incidenteId', 'tipo', 'ubicacion', 'gravedad', 'estado', 'creadoPor']) &&
               d.keys().hasOnly(['incidenteId', 'tipo', 'ubicacion', 'coords', 'gravedad', 'estado', 'descripcion',
                                 'fecha', 'creadoPor', 'creadaEn']) &&
               d.incidenteId is string && d.incidenteId.matches('INC-[A-Z0-9-]{2,24}') &&
               textoCorto(d.tipo, 100) && textoCorto(d.ubicacion, 200) &&
               d.gravedad in ['alta', 'media', 'baja'] && d.estado == 'abierto' &&
               d.creadoPor == request.auth.uid &&
               (!('descripcion' in d) || textoCorto(d.descripcion, 500)) &&
               (!('fecha' in d) || textoCorto(d.fecha, 40)) &&
               (!('coords' in d) || (d.coords is list && d.coords.size() == 2));
      }
      allow read: if estaAutenticado();
      allow create: if estaAutenticado() && incidenteValido();
      // La cuadrilla puede tomar o cerrar un incidente; solo la autoridad lo edita o lo borra
      allow update: if esAutoridad() || (esRecolector() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']) &&
        request.resource.data.estado in ['en_atencion', 'resuelto']);
      allow delete: if esAutoridad();
    }

    // Colección: Notificaciones push y avisos de campañas
    match /notificaciones/{notifId} {
      allow read: if true;
      allow write: if esAutoridad();
    }

    // Colección: roles asignados por correo de Google (escritura solo desde administración)
    match /roles_por_correo/{correo} {
      allow get: if cuentaGoogleVerificada() && request.auth.token.email == correo;
      allow list, write: if false;
    }

    // Colección: Dispositivos registrados para recibir push (el id del documento es el token de FCM)
    // Solo escriben quienes tienen sesión y a nombre propio; la lectura queda reservada al emisor (administración)
    match /dispositivos/{tokenId} {
      function dispositivoValido() {
        let d = request.resource.data;
        return d.keys().hasOnly(['uid', 'rol', 'actualizado']) && d.uid == request.auth.uid &&
               (d.rol == 'ciudadano' || (d.rol == 'autoridad' && esAutoridad()) ||
                (d.rol == 'recolector' && esRecolector()));
      }
      allow create: if estaAutenticado() && dispositivoValido();
      allow update: if estaAutenticado() && resource.data.uid == request.auth.uid && dispositivoValido();
      allow delete: if estaAutenticado() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Colección: Telemetría de Contenedores y Sensores IoT
    match /telemetria_contenedores/{contenedorId} {
      allow read: if true;
      // Solo la autoridad publica lecturas (el simulador y la pasarela de sensores usan sus credenciales)
      allow create, update: if esAutoridad() && request.resource.data.keys().hasOnly(
          ['dispositivoId', 'nombre', 'porcentajeLlenado', 'temperaturaCelsius',
           'bateriaPorcentaje', 'alertaDesborde', 'ultimaActualizacion', 'ubicacion',
           'distanciaSensorCm', 'alertaTemperatura', 'coordsLat', 'coordsLng']) &&
        (!('porcentajeLlenado' in request.resource.data) ||
          (request.resource.data.porcentajeLlenado is number &&
           request.resource.data.porcentajeLlenado >= 0 && request.resource.data.porcentajeLlenado <= 100));
      allow update: if esRecolector() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['porcentajeLlenado', 'alertaDesborde', 'ultimaActualizacion']) &&
        request.resource.data.porcentajeLlenado is number &&
        request.resource.data.porcentajeLlenado >= 0 && request.resource.data.porcentajeLlenado <= 15;
      allow delete: if esAutoridad();
    }
  }
}
